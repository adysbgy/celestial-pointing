{
  "sourceLanguage": "id",
  "version": "1.0",
  "strings": {
    "experiment.status.initial": {
      "comment": "Panduan awal layar Experiment 1.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a target, aim, then record."
          }
        }
      }
    },
    "experiment.status.noTarget": {
      "comment": "Rekam ditekan tanpa memilih target.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a target first — without ground truth, the recording can't be analyzed."
          }
        }
      }
    },
    "experiment.status.sensorOff": {
      "comment": "Sensor gerak mati saat merekam percobaan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion sensor is off — the remaining aim is not a current measurement. Nothing was recorded."
          }
        }
      }
    },
    "experiment.status.noPointing": {
      "comment": "Sensor belum memberi arah tunjuk.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No aim from the sensor yet — nothing was recorded."
          }
        }
      }
    },
    "experiment.status.targetUncomputable": {
      "comment": "Arah target kebenaran tidak bisa dihitung.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction of target %@ can't be computed — the trial was not saved."
          }
        }
      }
    },
    "experiment.status.recorded": {
      "comment": "Ringkasan satu percobaan tersimpan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorded: error %@, %@. Engine answer: %@."
          }
        }
      }
    },
    "experiment.status.removed": {
      "comment": "Percobaan terakhir dibuang.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removed: %@."
          }
        }
      }
    },
    "experiment.status.nothingToRemove": {
      "comment": "Tidak ada percobaan yang bisa dibuang.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trial to remove."
          }
        }
      }
    },
    "experiment.status.reset": {
      "comment": "Seluruh dataset dikosongkan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataset cleared."
          }
        }
      }
    },
    "experiment.verdict.falseLock": {
      "comment": "Putusan percobaan: engine yakin tapi salah (huruf besar, sengaja).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FALSE LOCK"
          }
        }
      }
    },
    "experiment.verdict.correct": {
      "comment": "Putusan percobaan: benar (bentuk pendek di daftar).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "correct"
          }
        }
      }
    },
    "experiment.verdict.wrong": {
      "comment": "Putusan percobaan: salah (bentuk pendek di daftar).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "wrong"
          }
        }
      }
    },
    "experiment.verdict.notAnalyzed": {
      "comment": "Putusan percobaan: tak dianalisis (bentuk pendek di daftar).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not analyzed"
          }
        }
      }
    },
    "experiment.verdict.falseLock.sentence": {
      "comment": "Putusan percobaan untuk diucapkan: false lock.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "False lock: the engine was confident but wrong."
          }
        }
      }
    },
    "experiment.verdict.correct.sentence": {
      "comment": "Putusan percobaan untuk diucapkan: benar.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct."
          }
        }
      }
    },
    "experiment.verdict.wrong.sentence": {
      "comment": "Putusan percobaan untuk diucapkan: salah.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong."
          }
        }
      }
    },
    "experiment.verdict.notAnalyzed.sentence": {
      "comment": "Putusan percobaan untuk diucapkan: tak dianalisis.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not analyzed."
          }
        }
      }
    },
    "experiment.detail.noAnswer": {
      "comment": "Kata pengganti nama objek saat engine belum menjawab.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "none yet"
          }
        }
      }
    },
    "experiment.detail.noError": {
      "comment": "Kata pengganti galat saat tidak ada analisis.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "—"
          }
        }
      }
    },
    "experiment.detail.answer": {
      "comment": "Baris detail: jawaban engine.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "answer %@"
          }
        }
      }
    },
    "experiment.detail.confidence": {
      "comment": "Baris detail: tingkat keyakinan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "confidence %@"
          }
        }
      }
    },
    "experiment.detail.state": {
      "comment": "Baris detail: keadaan alur saat direkam.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "state %@"
          }
        }
      }
    },
    "experiment.detail.error": {
      "comment": "Baris detail: galat tunjuk, bentuk tampilan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "error %.1f°"
          }
        }
      }
    },
    "experiment.detail.rate": {
      "comment": "Baris detail: laju pergelangan, bentuk tampilan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f°/s"
          }
        }
      }
    },
    "experiment.target.option": {
      "comment": "Opsi pemilih target: nama dan tinggi.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %.0f°"
          }
        }
      }
    },
    "experiment.summary.noAnalyzable": {
      "comment": "Ringkasan: belum ada percobaan yang bisa dianalisis.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trial that can be analyzed yet."
          }
        }
      }
    },
    "experiment.summary.failed": {
      "comment": "Ringkasan: ada false lock, klaim keselamatan gagal.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FAILED: %lld false lock — the engine was confident but wrong. The confidence threshold must be tightened. Accuracy %@, median error %@, P90 %@."
          }
        }
      }
    },
    "experiment.summary.insufficient": {
      "comment": "Ringkasan: nol false lock tapi sampel belum cukup.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot conclude yet: 0 false lock out of %lld trials — the sample is not enough (needs at least %lld). Accuracy %@, median pointing error %@, P90 %@. This is not proof of safety, only an absence of counter-evidence."
          }
        }
      }
    },
    "experiment.summary.passed": {
      "comment": "Ringkasan: sampel cukup dan tanpa false lock.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passed the safety requirement (0 false lock out of %lld trials). Accuracy %@, median pointing error %@, P90 %@."
          }
        }
      }
    },
    "experiment.diagnosis.noSamples": {
      "comment": "Diagnosis: belum ada sampel.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No samples yet."
          }
        }
      }
    },
    "experiment.diagnosis.noAnswers": {
      "comment": "Diagnosis: belum ada jawaban sama sekali.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No answers at all yet. Aim at the sky and hold until the wrist is still."
          }
        }
      }
    },
    "experiment.diagnosis.tooFar": {
      "comment": "Diagnosis: semua jawaban ragu karena kandidat terlalu jauh.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every answer was uncertain because the candidate was too far from the aim. Fix the calibration first."
          }
        }
      }
    },
    "experiment.diagnosis.ambiguous": {
      "comment": "Diagnosis: semua jawaban ragu karena dua kandidat berdekatan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every answer was uncertain because two candidates were close together. This is an accuracy limit, not a calibration mistake."
          }
        }
      }
    },
    "experiment.diagnosis.noMeasurableCause": {
      "comment": "Diagnosis: ragu tanpa sebab terukur.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers were uncertain with no measurable cause — check whether the aim makes sense."
          }
        }
      }
    },
    "experiment.diagnosis.ratio": {
      "comment": "Diagnosis: rasio jawaban yakin.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f%% confident answers (%lld confident, %lld uncertain)."
          }
        }
      }
    },
    "experiment.diagnosis.mixed": {
      "comment": "Diagnosis saat dua sebab atau lebih berbagi hitungan tertinggi. Satu slot %@ menerima daftar sebab yang sudah disambung; pemisahnya punya kunci sendiri.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasons for uncertainty are shared: %@"
          }
        }
      }
    },
    "experiment.diagnosis.mixedSeparator": {
      "comment": "Pemisah antarsebab pada kalimat diagnosis seri.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "; and "
          }
        }
      }
    },
    "experiment.suggestedThreshold": {
      "comment": "Usulan ambang keyakinan dari sigma terukur.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested confidence threshold: σ %.1f°"
          }
        }
      }
    },
    "experiment.location.fallback": {
      "comment": "Peringatan lokasi masih bawaan: tinggi objek dihitung untuk tempat lain.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location not yet available — the altitudes below are computed for %@, not your place."
          }
        }
      }
    },
    "experiment.location.computed": {
      "comment": "Keterangan lokasi tempat tinggi objek dihitung.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computed for %@."
          }
        }
      }
    },
    "row.speech.label": {
      "comment": "Penggabungan satu baris judul:nilai untuk VoiceOver.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "row.speech.degrees": {
      "comment": "Satuan sudut dalam bentuk kata (diucapkan).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "degrees"
          }
        }
      }
    },
    "row.speech.degreesPerSecond": {
      "comment": "Satuan laju sudut dalam bentuk kata (diucapkan).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "degrees per second"
          }
        }
      }
    },
    "row.speech.errorWord": {
      "comment": "Kata yang menyebut apa yang diukur galat pointing.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "error"
          }
        }
      }
    },
    "row.speech.wristRate": {
      "comment": "Kalimat pengumuman laju pergelangan di kartu keadaan jam. Urutan specifier WAJIB sama dengan kode: %@ = kata pengukur (row.speech.wristRateWord), %.0f = angka, %@ = satuan (row.speech.degrees). Menukar posisinya = crash di CoreFoundation — lihat Aturan 11 di swift-ui-lint.sh.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %.0f %@ per second."
          }
        }
      }
    },
    "row.speech.wristRateWord": {
      "comment": "Kata yang menyebut apa yang diukur laju pergelangan pada pengumuman.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrist rate"
          }
        }
      }
    },
    "row.speech.stateLine": {
      "comment": "Awalan kalimat keadaan untuk pengumuman kartu jam. %@ = label keadaan (pointing.state.*.label, yang punya kuncinya sendiri). Semula literal \"Keadaan: \\(state.shortLabel).\" di dalam view.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status: %@."
          }
        }
      }
    },
    "location.fallback.label": {
      "comment": "Label lokasi darurat (Jakarta) yang tampil di layar utama jam. Bukan lokasi pengukuran.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakarta (default)"
          }
        }
      }
    },
    "link.status.calibrationNotSent": {
      "comment": "Hasil kalibrasi tidak terkirim: sesi WatchConnectivity belum aktif.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration not sent: session is not active yet."
          }
        }
      }
    },
    "link.status.messageNotSent": {
      "comment": "Pesan tidak terkirim: sesi WatchConnectivity belum aktif.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Message not sent: session is not active yet."
          }
        }
      }
    },
    "link.status.sendFailed": {
      "comment": "Pengiriman gagal, dengan alasan dari sistem. %@ = localizedDescription OS (tidak diterjemahkan ulang).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send failed: %@"
          }
        }
      }
    },
    "link.status.sent": {
      "comment": "Pengiriman berhasil. %@ = nama jenis pesan untuk manusia.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent: %@"
          }
        }
      }
    },
    "link.status.watchSaw": {
      "comment": "Jam melihat sebuah objek. %@ = nama objek.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch saw %@"
          }
        }
      }
    },
    "link.status.stateFromWatch": {
      "comment": "Keadaan diterima dari jam, tanpa nama objek.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State from the watch"
          }
        }
      }
    },
    "link.status.calibrationFromWatch": {
      "comment": "Hasil kalibrasi diterima dari jam.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration from the watch"
          }
        }
      }
    },
    "link.status.policyFromWatch": {
      "comment": "Ambang keyakinan diterima dari jam.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watch sent a confidence threshold"
          }
        }
      }
    },
    "link.status.acknowledgement": {
      "comment": "Tanda terima diterima.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledgement"
          }
        }
      }
    },
    "link.status.invalidPolicy": {
      "comment": "Ambang keyakinan dari iPhone tidak sah, jadi diabaikan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confidence threshold from the iPhone is not valid — ignored"
          }
        }
      }
    },
    "link.status.stateRequestTooEarly": {
      "comment": "Permintaan keadaan datang sebelum alur siap.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State request arrived before the flow was ready."
          }
        }
      }
    },
    "link.status.watchUnreachablePolicy": {
      "comment": "Jam belum terhubung sehingga ambang keyakinan tidak terkirim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch not connected — threshold not sent."
          }
        }
      }
    },
    "link.status.watchUnreachableMessage": {
      "comment": "Jam belum terhubung sehingga pesan tidak terkirim.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch not connected — message not sent."
          }
        }
      }
    },
    "link.status.sendFailures": {
      "comment": "Kalimat jumlah pengiriman tautan yang gagal. %lld = jumlah, %@ = kata benda. Semula pemanggil merakitnya dengan MENYAMBUNG string, sehingga urutannya terpaku di kode dan bahasa lain tidak bisa mengatakannya.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". %lld %@."
          }
        }
      }
    },
    "link.status.sendFailuresWord": {
      "comment": "Kata benda untuk kiriman yang gagal. Dipisah dari link.status.sendFailed karena yang ini menyebut JUMLAH kiriman, bukan satu kejadian.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "messages failed"
          }
        }
      }
    },
    "link.note.calibrated": {
      "comment": "Keadaan jam: terkalibrasi. Tampil di layar Tautan iPhone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "calibrated"
          }
        }
      }
    },
    "link.note.notCalibrated": {
      "comment": "Keadaan jam: belum terkalibrasi. Tampil di layar Tautan iPhone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not calibrated"
          }
        }
      }
    },
    "row.speech.error": {
      "comment": "Kalimat galat pointing: kata, angka, satuan. Urutan tipe specifier wajib sama dengan template kode (%@ %.1f %@) — Aturan 11 menegakkannya.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %.1f %@"
          }
        }
      }
    },
    "calibration.message.idle": {
      "comment": "Panduan awal alur kalibrasi.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at a reference star, then tap to record."
          }
        }
      }
    },
    "calibration.message.needMore": {
      "comment": "Belum cukup acuan; dua angka disisipkan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need at least %lld references (%lld recorded)."
          }
        }
      }
    },
    "calibration.message.spreadTooWide": {
      "comment": "Sebaran sisa terlalu lebar.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spread %.1f° is still too wide (max %.1f°). Add more references."
          }
        }
      }
    },
    "calibration.message.ready": {
      "comment": "Kalibrasi sudah layak dipakai.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready — spread %.1f° from %lld references."
          }
        }
      }
    },
    "calibration.message.applied": {
      "comment": "Kalibrasi sudah dipasang.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration applied."
          }
        }
      }
    },
    "calibration.message.sensorUnavailable": {
      "comment": "Sensor gerak mati saat mencatat acuan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Motion sensor is off — the remaining aim is not a current measurement. Not recorded."
          }
        }
      }
    },
    "calibration.message.noPointing": {
      "comment": "Sensor belum memberi arah tunjuk.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No aim from the sensor yet."
          }
        }
      }
    },
    "calibration.message.directionUncomputable": {
      "comment": "Arah objek acuan tidak bisa dihitung.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direction of %@ can't be computed — not recorded."
          }
        }
      }
    },
    "calibration.message.noNearbyStar": {
      "comment": "Tidak ada bintang acuan yang jelas.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No clear reference star in that direction — aim closer to a bright star."
          }
        }
      }
    },
    "calibration.speech.phasePrefix": {
      "comment": "Awalan pengumuman tahap kalibrasi.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase: %@."
          }
        }
      }
    },
    "calibration.speech.samplesRecorded": {
      "comment": "Jumlah acuan yang tercatat, diucapkan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld references recorded."
          }
        }
      }
    },
    "calibration.speech.offset": {
      "comment": "Offset kalibrasi, diucapkan.",
      "localizations": {
