        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisa pandangan sebelumnya — bukan hasil sekarang"
          }
        }
      }
    },
    "onboarding.honesty": {
      "comment": "Janji produk onboarding: ketidak-pastian ditampilkan apa adanya.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it is unsure, the engine will say so. Nothing is claimed as certain until it is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika ragu, engine akan mengatakannya. Tidak ada yang diklaim sebagai pasti bila belum."
          }
        }
      }
    },
    "onboarding.label": {
      "comment": "Label VoiceOver kartu onboarding utuh (merangkum ketiga baris).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduction. Point your watch at the sky to learn what you are looking at. If unsure, the engine will say so."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkenalan. Arahkan jam ke langit untuk mengetahui benda yang kamu lihat. Jika ragu, engine akan mengatakannya."
          }
        }
      }
    },
    "onboarding.start.label": {
      "comment": "Label tombol tutup kartu onboarding.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai"
          }
        }
      }
    },
    "onboarding.subtitle": {
      "comment": "Subjudul onboarding: apa yang didapat setelah menunjuk.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aim at a body and learn what you are looking at — and how confident the engine is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjuk sebuah benda, dan ketahui apa yang sedang kamu lihat — bersama seberapa yakin engine mengenalinya."
          }
        }
      }
    },
    "onboarding.title": {
      "comment": "Judul kartu perkenalan value-first (layar onboarding).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point your watch at the sky"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan jam ke langit"
          }
        }
      }
    },
    "pointing.announce.locked": {
      "comment": "VoiceOver: keadaan terkunci tetapi nama objeknya tidak tersedia. Diucapkan saat keadaan berubah, bukan tiap sampel.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terkunci."
          }
        }
      }
    },
    "pointing.announce.lockedOn": {
