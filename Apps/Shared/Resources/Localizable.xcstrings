        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisa pandangan sebelumnya, bukan hasil sekarang."
          }
        }
      }
    },
    "object.speech.staleShort": {
      "comment": "Penanda sisa versi pendek untuk layar redup (Always-On). Bukan satu kata \"sisa\": di layar tanpa panel peringatan, satu kata tidak menjelaskan sisa APA.",
