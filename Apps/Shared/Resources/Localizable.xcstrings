        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor unavailable. %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor mati. %@"
          }
        }
      }
    },
    "pointing.announce.uncertain": {
