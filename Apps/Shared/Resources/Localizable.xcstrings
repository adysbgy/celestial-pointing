    "row.speech.stateLine": {
      "comment": "Awalan kalimat keadaan untuk pengumuman kartu jam. %@ = label keadaan (pointing.state.*.label, yang punya kuncinya sendiri). Semula literal \"Keadaan: \\(state.shortLabel).\" di dalam view.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status: %@."
