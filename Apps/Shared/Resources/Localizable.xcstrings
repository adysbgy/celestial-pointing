          "stringUnit": {
            "state": "translated",
            "value": "Note (optional)"
          }
        }
      }
    },
    "Dataset Experiment 1": {
      "comment": "Judul berkas di lembar berbagi saat mengekspor dataset percobaan.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experiment 1 dataset"
          }
        }
      }
    },
    "object.speech.confidence": {
      "comment": "VoiceOver: tingkat keyakinan objek. %@ = nama tingkat (Yakin/Ragu/Tidak tahu), sudah diterjemahkan sendiri.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "confidence %@"
          }
        }
      }
    },
    "object.speech.coordinates": {
      "comment": "VoiceOver: koordinat bintang. Argumen 1 = RA derajat, argumen 2 = deklinasi derajat (bertanda).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RA %.1f degrees, declination %+.1f degrees"
          }
        }
      }
    },
    "object.speech.magnitude": {
      "comment": "VoiceOver: magnitudo tampak objek. Angka tidak pernah diucapkan tanpa katanya.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "magnitude %.2f"
          }
        }
      }
    },
    "object.speech.stale": {
      "comment": "VoiceOver: penanda bahwa objek berasal dari pandangan sebelumnya, bukan hasil pengukuran sekarang.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From an earlier view, not a current reading."
          }
        }
      }
    },
    "pointing.announce.locked": {
      "comment": "VoiceOver: keadaan terkunci tetapi nama objeknya tidak tersedia. Diucapkan saat keadaan berubah, bukan tiap sampel.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked."
          }
        }
      }
    },
    "pointing.announce.lockedOn": {
      "comment": "VoiceOver: terkunci pada sebuah objek. %@ = nama objek, sudah diterjemahkan sendiri.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked on %@."
          }
        }
      }
    },
    "pointing.announce.state": {
      "comment": "VoiceOver: keadaan berubah tanpa jawaban. Argumen 1 = label keadaan, argumen 2 = kalimat panduan; keduanya sudah diterjemahkan sendiri.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. %2$@"
          }
        }
      }
    },
    "pointing.announce.unavailable": {
      "comment": "VoiceOver: sensor tidak tersedia. %@ = kalimat panduan, sudah diterjemahkan sendiri.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensor unavailable. %@"
          }
        }
      }
    },
    "pointing.announce.uncertain": {
      "comment": "VoiceOver: ada kandidat tetapi engine tidak cukup yakin. %@ = kalimat panduan, sudah diterjemahkan sendiri.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not certain. %@"
          }
        }
      }
    },
    "pointing.search.hint.daylight": {
      "comment": "Alasan: langit belum cukup gelap untuk melihat bintang.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky is still bright — stars are not visible yet."
