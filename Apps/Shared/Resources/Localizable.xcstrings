        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "from an earlier view"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "sisa pandangan sebelumnya"
          }
        }
      }
    },
    "objectDetail.staleNote.display": {
