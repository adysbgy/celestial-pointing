/* System permission strings — shown in iOS/watchOS dialogs, outside
   the app string catalog's reach. Without this file the dialog is
   Indonesian for every user. */

NSLocationWhenInUseUsageDescription = "Location is used to compute where sky objects appear in your sky. Without it the app falls back to a clearly labelled default location, and results are marked as possibly invalid.";
NSMotionUsageDescription = "Motion data is used to measure where you are pointing. Sensor accuracy is not assumed — that is exactly what Experiment 1 measures.";
NSLocalNetworkUsageDescription = "Local network access is used to send commands to your telescope after an object is identified. The app only talks to the device you choose, and never moves the telescope without an object identification that passed the safety check.";
